# /etc/elcodelabs/backup.env — chmod 600, owned by root. Every line is optional.
# Telegram: create a bot with @BotFather, send it one message, then read the chat id from
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Rotation per database (defaults: 5 daily, 2 weekly, 1 monthly) and the disk guard.
KEEP_DAILY=5
KEEP_WEEKLY=2
KEEP_MONTHLY=1
MIN_FREE_PCT=15
